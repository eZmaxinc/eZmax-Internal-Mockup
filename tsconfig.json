{
   "compilerOptions": {
      "target": "ES2022",
      "module": "ESNext",
      "moduleResolution": "Bundler",
      "strict": true,
      "jsx": "preserve",
      "resolveJsonModule": true,
      "isolatedModules": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "noEmit": true,
      "lib": ["ES2022", "DOM", "DOM.Iterable"],
      "types": ["vite/client", "node"],
      "paths": {
         "@ez": ["./blueprint/ez/index.ts"],
         "@ez/*": ["./blueprint/ez/*"],
         "@mocks": ["./blueprint/mocks/index.ts"],
         "@mocks/*": ["./blueprint/mocks/*"],
         "@blueprint/*": ["./blueprint/*"],
         "@/*": ["./tool/*"]
      }
   },
   "include": ["./blueprint/**/*", "./prototypes/**/*", "./tool/**/*.ts", "./tool/**/*.vue", "./tool/**/*.d.mts"]
}
